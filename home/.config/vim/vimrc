vim9script
# vim: foldenable foldlevel=0

runtime defaults.vim

# set foldmethod=marker foldlevel=1
set foldmethod=marker
set expandtab smarttab shiftwidth=4
set ignorecase smartcase
set number relativenumber
set wildmenu wildoptions=pum
set ignorecase smartcase
set display=lastline laststatus=2 smoothscroll
set linebreak breakindent breakindentopt=shift:2
set hlsearch
set modeline
set belloff=all

&grepprg = [
    'grep',
    '--line-number',
    '--with-filename',
    '--recursive',
    '--ignore-case',
    '--perl-regexp',
    '--binary-files=without-match',
    '--exclude-dir .git',
    '--exclude-dir .cvs',
    '--exclude-dir .svn',
    '--exclude-dir .hg',
    '--exclude-dir node_modules',
    '$*'
]->join()

# GUI OPTIONS {{{
set mouse=
# }}}

command! -nargs=+ GrepCustom {
    execute 'silent grep! <args>'
    copen
    redraw!
}

var vertical_help_threshold: number = 160
command! -nargs=1 -complete=help HelpCustom {
    var modifier: string = (
        getwininfo(win_getid())[0].width < vertical_help_threshold
            ? "horizontal" : "vertical"
    )
    execute modifier "<mods> help <args>"
}

g:mapleader = "\<Space>"
g:maplocalleader = "\<Space>"
nnoremap <Leader>h <Cmd>set hlsearch! hlsearch?<CR>
nnoremap <Leader>p <Cmd>set paste! paste?<CR>
nnoremap <Leader>l <Cmd>set list! list?<CR>
nnoremap <Leader>n <Cmd>set number! relativenumber!<CR>

cnoreabbrev <expr> h getcmdtype()    =~ '[/?]' ? 'h'    : 'HelpCustom'
cnoreabbrev <expr> here getcmdtype() =~ '[/?]' ? 'here' : 'chdir %:h'
cnoreabbrev <expr> grep getcmdtype() =~ '[/?]' ? 'grep' : 'GrepCustom'

command! -nargs=1 -complete=file SudoWrite silent write !sudo tee <args> >/dev/nul

colorscheme desert

def CountRepeated(cmd: string): string
    return repeat([cmd], v:count1)->join("|")->printf("\<Cmd>%s\<CR>")
enddef

nnoremap <expr> g] <SID>CountRepeated("bn")
nnoremap <expr> g[ <SID>CountRepeated("bp")



# Plugin management {{{

def GetDataHome(): string
    # {{{
    if $XDG_DATA_HOME !=# ''
        return $XDG_DATA_HOME
    endif
    return $HOME .. '/.local/share'
enddef # }}}


def GetPluginHome(): string
    #{{{
    return GetDataHome() .. '/vim-plug'
enddef #}}}


def LoadVimPlug(): void #{{{
    var plugin_home = GetPluginHome()
    var plug_file = (plugin_home, 'plug.vim')->join('/')

    if !filereadable(plug_file)
        var src = 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
        echo '"vim-plug" not found. Downloading...'
        execute ('!curl -fLo', plug_file, '--create-dirs', src)->join()
    endif

    execute 'source' plug_file
enddef # }}}


def RegisterPlugins(): void
    #{{{
    plug#begin(s:GetPluginHome() .. '/repositories')

    # vim-surround {{{
    plug#('https://github.com/tpope/vim-surround.git')
    g:['surround_' .. char2nr('i')] = "*\r*"
    g:['surround_' .. char2nr('8')] = "*\r*"
    g:['surround_' .. char2nr('b')] = "**\r**"
    g:['surround_' .. char2nr('a')] = "***\r***"
    g:['surround_' .. char2nr('s')] = "~~\r~~"
    g:['surround_' .. char2nr('c')] = "{{clozeblank::\r::}}"
    g:['surround_' .. char2nr('u')] = "!u[\r]"
    g:['surround_' .. char2nr('h')] = "==\r=="
    g:['surround_' .. char2nr('m')] = "::: incremental\n\r\n:::"
    # }}}

    # vim-commentary: Toggle commenting stuff out. {{{
    #    - Use gcc to comment out a line (takes a count)
    #    - gc to comment out the target of a motion
    #    - gc in visual mode to comment out the selection
    #    - gc in operator pending mode to target a comment.
    # If we're on this patch, we should be using `:packadd comment` instead
    if !has('patch-9.1.0375')
        plug#('https://github.com/tpope/vim-commentary')
    endif
    # }}}

    # vim-repeat: Remaps '.' in a way that plugins can tap into it
    plug#('https://github.com/tpope/vim-repeat')

    # vim-easy-align: a simple, easy-to-use Vim alignment plugin. {{{
    plug#('https://github.com/junegunn/vim-easy-align')

    # Start interactive EasyAlign in visual mode (e.g. vipga)
    xmap ga <Plug>(EasyAlign)

    # Start interactive EasyAlign for a motion/text object (e.g. gaip)
    nmap ga <Plug>(EasyAlign)
    # }}}

    # vim-speeddating: Use CTRL-A/CTRL-X to increment dates, times, and more
    plug#('https://github.com/tpope/vim-speeddating')

    # A Vim plugin to visualize the Vim undo tree.
    plug#('https://github.com/simnalamburt/vim-mundo')
    nnoremap U <Cmd>MundoToggle<CR>

    # LSP plugin written using only the Vim9 script.
    plug#('https://github.com/yegappan/lsp')
    s:RegisterLspServers()

    # Vim's internal markdown plugin (:help ft-markdown-plugin) is decent and,
    # though it supports folding (g:markdown_folding = 1), it does not support
    # pandoc's extensions. Because of that, vim's docs also suggest using
    # their internal markdown plugin (:help ft-pandoc-syntax), by setting
    # g:filetype_md to 'pandoc'. Unfortunately, said plugin doesn't seem to be
    # willing to detect folds and I need heading-level folding. And, thus,
    # this plugin comes to the game.
    # plug#('https://github.com/preservim/vim-markdown')
    plug#('https://github.com/brunofauth/vim-markdown')
    # I've put my settings to this plugin on $MYVIMDIR/ftplugin/markdown.vim
    # and $MYVIMDIR/after/ftplugin/markdown.vim
    # These BufWritePost autocmds are giving me trouble when editing markdown
    #       s:MarkdownRefreshSyntax(0)
    #       s:MarkdownSetupFolding()

    plug#('https://github.com/brunofauth/vim-md-vibes')

    plug#('/home/bruno/repo/ankicards/tools/vim-ankicards/')

    g:minisnip_default_maps = 0
    plug#('https://github.com/habamax/vim-minisnip')
    imap <C-j> <Plug>(minisnipTrigger)
    smap <C-j> <Plug>(minisnipTrigger)
    imap <C-r><C-j> <Plug>(minisnipShowAvailable)

    # plug#('https://github.com/tpope/vim-dadbod')
    # plug#('https://github.com/kristijanhusak/vim-dadbod-ui')

    plug#('https://github.com/powerman/vim-plugin-AnsiEsc')

    # The following plug-in could be replaced by the enabling of vim's
    # 'exrc'+'secure' settings, but I've opted for this plugin because it
    # gives the option to show a confirmation prompt before sourcing
    # project-local .vimrc|.exrc|.gvimrc files.
    #
    # NOTE: read    |localvimrc-variables|  |localvimrc-settings|
    g:localvimrc_persistence_file = GetDataHome() .. '/localvimrc-persistence-file'
    g:localvimrc_persistent = 1
    plug#('embear/vim-localvimrc')

    plug#end()
enddef #}}}

# }}} Plugin Management


def LoadBuiltinPackages(): void # {{{

    if has('patch-9.1.0375')
        packadd comment
    endif

    if has('patch-9.1.1230')
        packadd helptoc

        command! HelpTocFallback {
            HelpToc
            if b:->get("toc", {})->len() == 0
                execute "HelpCustom help.txt"
            endif
        }

        nnoremap <F1> <Cmd>HelpTocFallback<CR>
    endif

enddef
# }}}


# LSP Servers {{{

# :help lsp-options
const lsp_options = {
    autoPopulateDiags: v:true,
    completionMatcher: 'icase',

    diagVirtualTextAlign: 'above',
    showDiagWithVirtualText: v:false,

    showDiagWithSign: v:true,
    showDiagInPopup: v:true,
    # showDiagInBaloon: v:true,
    # showDiagWithVirtualText: v:false,
}

# Run this command for docs on what fields a LSP server entry may have
# :helpgrep To\ add\ a\ language\ server,\ the\ following\ information\ is\ needed:
var lsp_servers: list<dict<any>> = []


def RegisterLspServers(): void

    TryAddServer(lsp_servers, 'rust-analyzer', {
        name: 'rust-analyzer',
        filetype: ['rust'],
        args: [],
        syncInit: v:true,
    })

    TryAddServer(lsp_servers, 'clangd', {
        name: 'clangd',
        filetype: ['c', 'cpp'],
        args: ['--background-index', '--clang-tidy'],
    })

    TryAddServer(lsp_servers, 'nil', {
        name: 'nil',
        filetype: ['nix'],
        args: [],
        syncInit: v:true,
    })

    TryAddServer(lsp_servers, 'ty', {
        name: 'ty',
        filetype: ['python'],
        args: ['server'],
        syncInit: v:true,
    })

    TryAddServer(lsp_servers, 'ruff', {
        name: 'ruff',
        filetype: ['python'],
        args: ['server'],
        syncInit: v:true,
    })

    augroup lsp_client_setup
        autocmd!
        autocmd User LspSetup    g:LspOptionsSet(lsp_options) 
        autocmd User LspSetup    g:LspAddServer(lsp_servers)
        autocmd User LspAttached SetLspBuffer()
    augroup END
enddef


def TryAddServer(servers: list<dict<any>>, server_name: string, server_opts: dict<any>): void
    var server_path = exepath(server_name)
    if server_path ==# ''
        return
    endif
    server_opts['path'] = server_path
    servers->add(server_opts)
enddef

def SetLspBuffer(): void
    set keywordprg=:LspHover
    nnoremap <buffer> <Localleader>la <Cmd>LspCodeAction<CR>
    nnoremap <buffer> <Localleader>lh <Cmd>LspHover<CR>
    nnoremap <buffer> <Localleader>ld <Cmd>LspPeekDeclaration<CR>
    nnoremap <buffer> <Localleader>lD <Cmd>LspGotoDefinition<CR>
    nnoremap <buffer> <Localleader>li <Cmd>LspGotoImpl<CR>
    nnoremap <buffer> <Localleader>lr :LspRename\ 
    nnoremap <buffer> <Localleader>lR <Cmd>LspShowReferences<CR>
    nnoremap <buffer> <Localleader>ln <Cmd>LspDiag nextWrap<CR>
    nnoremap <buffer> <Localleader>lp <Cmd>LspDiag prevWrap<CR>
    nnoremap <buffer> <Localleader>ll <Cmd>LspDiag show<CR>
enddef

# }}} Lsp Servers


def Main(): void
    if $USER !=# 'root'
        call LoadVimPlug()
    else
        echomsg 'running as root --> third-party plugins are disabled'
    endif

    if get(g:, "loaded_plug", 0)
        RegisterPlugins()
    endif

    LoadBuiltinPackages()

enddef


Main()
